{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "api/odds.py", "use": "@vercel/python" },
    { "src": "api/games.py", "use": "@vercel/python" },
    { "src": "api/history.py", "use": "@vercel/python" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "odds/**", "use": "@vercel/static" },
    { "src": "sine/**", "use": "@vercel/static" },
    { "src": "gradient/**", "use": "@vercel/static" },
    { "src": "css/**", "use": "@vercel/static" },
    { "src": "js/**", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" },
    { "src": "fonts/**", "use": "@vercel/static" },
    { "src": "lib/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/odds", "dest": "/api/odds.py" },
    { "src": "/api/games", "dest": "/api/games.py" },
    { "src": "/api/history", "dest": "/api/history.py" },
    { "src": "/odds", "dest": "/odds/index.html" },
    { "src": "/odds/", "dest": "/odds/index.html" },
    { "src": "/sine", "dest": "/sine/index.html" },
    { "src": "/sine/", "dest": "/sine/index.html" },
    { "src": "/gradient", "dest": "/gradient/index.html" },
    { "src": "/gradient/", "dest": "/gradient/index.html" },
    { "handle": "filesystem" }
  ]
}
